# ============================================================
# PAC Backend — Production Environment Template for Render.com
# Configure these variables in Render Dashboard -> Environment
# ============================================================

# ── Application Settings ────────────────────────────────────
APP_NAME="PAC - PoliceIT Analytics Core"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# ── PostgreSQL Database (Render PostgreSQL Service) ─────────
# Paste your Render Internal Database URL here.
# Render URLs usually look like: postgres://user:pass@dpg-xxx-a/pac_db
# The application automatically converts postgres:// to postgresql+asyncpg://
DATABASE_URL=postgresql://pac_user:pac_password@dpg-xxx-a.singapore-postgres.render.com/pac_db?sslmode=require
DATABASE_URL_SYNC=postgresql://pac_user:pac_password@dpg-xxx-a.singapore-postgres.render.com/pac_db?sslmode=require

# ── Security & Authentication ────────────────────────────────
# Generate a strong 32-byte secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-strong-32-byte-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis Cache (Render Redis Service) ──────────────────────
# Render Redis URL format: redis://red-xxx:6379 or rediss://...
REDIS_URL=redis://red-xxx:6379/0
CELERY_ENABLED=false

# ── Neo4j Graph Database (Optional / Managed Neo4j Aura) ───
NEO4J_URI=bolt://neo4j-instance.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── AI Investigation Assistant (Google Gemini) ──────────────
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your-actual-google-gemini-api-key-here
EVIDENCE_RANKER_TOP_N=10

# ── Hybrid Ranking & MO Intelligence Weights ─────────────────
HYBRID_SEMANTIC_WEIGHT=0.50
HYBRID_FTS_WEIGHT=0.30
HYBRID_MO_WEIGHT=0.20

MO_CRIME_TYPE_WEIGHT=0.15
MO_CRIME_METHOD_WEIGHT=0.15
MO_WEAPON_WEIGHT=0.15
MO_ENTRY_METHOD_WEIGHT=0.12
MO_TARGET_WEIGHT=0.12
MO_ESCAPE_WEIGHT=0.08
MO_TIME_WEIGHT=0.08
MO_GANG_WEIGHT=0.08
MO_DISTRICT_WEIGHT=0.07

# ── CORS Configuration ───────────────────────────────────────
CORS_ORIGINS=["https://pac-fehvhyfs.onslate.in"]
